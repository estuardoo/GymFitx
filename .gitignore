# entorno
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
python_version.txt

# datos y estado de ejecucion (videos, clips, intermedios, logs, credenciales). Se deja pasar solo lo que pone DVC:
# los punteros input/*.dvc y input/.gitignore (el contenido va al remoto de DVC, nunca al historial)
input/*
!input/*.dvc
!input/.gitignore
sistema/
# modelos entrenados: se rehacen con el codigo + parameters/config.json + los datos; sus meta.json y graficas si se versionan
output/**/*.joblib
# modelos de MediaPipe (se descargan solos) y cloudflared
assets/

# respaldos del editor de puntos
*.bak

# laminas exportadas del pitch (el .pptx si se versiona)
docs/pitch/*.png

# salidas de trabajo de Claude
Claude outputs/

# archivos retirados a la espera de borrarse
_to_delete/

# llaves: nunca al repo (viven en ..\KEYS)
.env
*.env
config.local
*service-account*.json
*-key.json
accessKeys*.csv
.ipynb_checkpoints/
